NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
# PostgreSQL is used for all persistent data AND session storage (no Redis needed)
DATABASE_URL=postgresql://user:password@localhost:5432/ainurse

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret

# Providers
EXOTEL_API_KEY=your_exotel_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_SID=your_exotel_sid

SARVAM_API_KEY=your_sarvam_key

# Intron Voice API — REQUIRES an integrator-enabled key (needed for
# /tts/v1/generate and /file/v1/upload/sync). Used for African-language STT/TTS.
INTRON_API_KEY=your_intron_integrator_key

OPENAI_API_KEY=your_openai_key

# STT Provider (sarvam | whisper)
STT_DEFAULT_PROVIDER=sarvam
STT_WHISPER_BASE_URL=http://speaches:8000/v1

# RAG Configuration (Optional - uses defaults if not set)
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=5

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
ENCRYPTION_KEY=your_encryption_key_32_chars

# Messaging Channels
# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SECRET_TOKEN=your_webhook_secret_token
# WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# Arize AX Tracing (optional — server starts normally if these are absent)
# space_id is pre-populated by the Arize portal when you create a project.
# api_key: generate one at app.arize.com → Settings → API Keys.
ARIZE_SPACE_ID=your_space_id
ARIZE_API_KEY=your_arize_api_key
ARIZE_PROJECT_NAME=ai-nurse-poc

# Arize Phoenix experiment runner (eval CLI)
# For local Phoenix: docker run -p 6006:6006 arizephoenix/phoenix:latest
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_API_KEY=                          # leave blank for local Phoenix; required for Arize cloud

# Seed scripts (not needed at runtime)
TENANT_ID=your_tenant_uuid
PATIENT_PHONE=+911234567890
