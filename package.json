{
  "name": "ai-nurse-poc",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"cd admin-dashboard && npm run dev\"",
    "build": "tsc",
    "build:all": "npm run build && cd admin-dashboard && npm run build",
    "start": "ts-node src/index.ts",
    "start:prod": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate-tenant": "ts-node scripts/migrate-to-multi-tenant.ts",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "node scripts/seed-data.js",
    "seed": "node scripts/seed-demo-data.js",
    "db:reset": "npx prisma migrate reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && cd admin-dashboard && npm install && cd .. && npm run db:migrate && npm run db:generate",
    "eval:generate-dataset": "ts-node src/eval/generate-dataset.ts",
    "eval:run-experiment": "ts-node src/eval/run-experiment.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/node-cache": "^4.1.3",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^8.57.1",
    "ioredis": "^5.9.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-openai": "^4.1.3",
    "@arizeai/phoenix-client": "^6.10.0",
    "@breezystack/lamejs": "^1.2.7",
    "@langchain/community": "^1.1.22",
    "@langchain/core": "^1.1.31",
    "@langchain/openai": "^1.2.12",
    "@langchain/textsplitters": "^1.0.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@prisma/client": "5.22.0",
    "@types/multer": "^2.1.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.30",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "openai": "^6.22.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.6"
  }
}
